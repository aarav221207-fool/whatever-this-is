# Environment (development, staging, production)
APP_ENV=development

# Upload Limits
MAX_UPLOAD_SIZE_MB=10

# Optional LLM Configuration
# Set LLM_ENABLED=true and provide an API key to enable semantic LLM extraction.
# If LLM_ENABLED=false (default), the parser uses deterministic rule-based extraction without external calls.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
LLM_TIMEOUT_SECONDS=30

# Logging & Operational Settings
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60

